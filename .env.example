# setup generates a random key automatically when .env does not exist.
GATEWAY_API_KEY=replace-with-a-random-key-of-at-least-16-characters
HOST=127.0.0.1
PORT=4141
ACCOUNT_TYPE=individual
REQUEST_TIMEOUT_MS=300000
MAX_CONCURRENT_REQUESTS=8
MIN_REQUEST_INTERVAL_MS=0
MAX_BODY_BYTES=4194304
MAX_RETRIES=2
MAX_RETRY_DELAY_MS=10000
MODEL_CACHE_TTL_MS=60000
MODEL_ALIASES={}
COPILOT_API_VERSION=2026-06-01
EDITOR_VERSION=1.115.0
PLUGIN_VERSION=0.44.0
# Prefer device login. Supply OAuth credentials here only at runtime.
# GITHUB_TOKEN=
# GITHUB_TOKEN_FILE=/private/path/github-token
